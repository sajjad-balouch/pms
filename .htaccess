<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # School domains (aischoolofsciences.com waghera) -> MSK Devs software, through msk-bridge
    # assanzameen.com, www aur iske subdomains is se bahar hain. SSL ki files bhi.
    # Apna computer (localhost / WiFi IP) bhi bahar, taa-ke local par yahi site khule.
    RewriteCond %{HTTP_HOST} !(^|\.)assanzameen\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\]|192\.168\.[0-9.]+|10\.[0-9.]+)(:[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_URI} !/msk-bridge/
    RewriteCond %{REQUEST_URI} !/\.well-known/acme-challenge/
    RewriteRule ^ msk-bridge/index.php [L]

    # Livewire ki published JS browser ko chahiye, baqi vendor block rahe
    RewriteRule ^vendor/livewire/(livewire(\.esm|\.min)?\.js(\.map)?|manifest\.json)$ - [L]

    # Project root hi web root hai: code, logs aur config public na hon
    RewriteRule ^(app|bootstrap|config|database|docs|node_modules|resources|routes|tests|vendor|storage/logs|storage/framework|storage/app/private)(/|$) - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|README\.md|CHANGELOG\.md|(vite|tailwind|postcss)\.config\.js|\.env.*|\.htaccessold)$ - [F,L]

    # Purane uploaded documents kabhi public na hon
    RewriteRule ^(public/)?scans(/|$) - [F,L]

    # Sirf ek domain index ho: canonical tags www par hain
    RewriteCond %{HTTP_HOST} ^assanzameen\.com$ [NC]
    RewriteRule ^ https://www.assanzameen.com%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Handle Front Controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>