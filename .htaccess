<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Livewire ki published JS browser ko chahiye, baqi vendor block rahe
    RewriteRule ^vendor/livewire/(livewire(\.esm|\.min)?\.js(\.map)?|manifest\.json)$ - [L]

    # Project root hi web root hai: code, logs aur config public na hon
    RewriteRule ^(app|bootstrap|config|database|docs|node_modules|resources|routes|tests|vendor|storage/logs|storage/framework|storage/app/private)(/|$) - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|README\.md|CHANGELOG\.md|(vite|tailwind|postcss)\.config\.js|\.env.*|\.htaccessold)$ - [F,L]

    # Sirf ek domain index ho: canonical tags www par hain
    RewriteCond %{HTTP_HOST} ^assanzameen\.com$ [NC]
    RewriteRule ^ https://www.assanzameen.com%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Handle Front Controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>